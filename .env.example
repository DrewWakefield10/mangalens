# Copy to ignored .env.local for hosted mode, or .env for Python mode.
# Vercel uses browser processing when API_INTERNAL_URL is absent.
# MANGALENS_CLOUD=1
# SUPABASE_URL=https://your-project.supabase.co
# MANGALENS_GATEWAY_SECRET=generate-a-random-32-byte-token
# DEEPL_API_KEY=your-deepl-api-free-key
# OCR_SPACE_API_KEY=your-ocr-space-free-key
# Never prefix secrets with NEXT_PUBLIC_.
# Optional Python backend: API_INTERNAL_URL=https://your-existing-api.example.com
# Local defaults to the Python API at http://127.0.0.1:8000.
# Remaining settings below are for the separate Python API and worker.
# Native defaults resolve data/models/assets beneath this repository.
# DATA_DIR=/persistent/mangalens/data
# MODEL_DIR=/persistent/mangalens/models
# FONT_PATH=/app/assets/fonts/NotoSansCJKjp-Regular.otf
# Native default: SQLite. Compose overrides this with PostgreSQL.
# DATABASE_URL=postgresql+psycopg://mangalens:change-me@localhost:5432/mangalens
POSTGRES_PASSWORD=change-this-local-password
TRANSLATION_PROVIDER=deepl
FALLBACK_PROVIDER=
ALLOWED_ORIGIN=http://localhost:3000
# Hosted: comma-separated exact frontend origins, including explicitly trusted
# previews if needed. Do not use wildcards or allow every *.vercel.app site.
# ALLOWED_ORIGIN=https://mangalens.example.com,https://your-preview.vercel.app
# Hosted HTTPS must use true. Local HTTP uses false.
COOKIE_SECURE=false
RETENTION_DAYS=7
MAX_UPLOAD_MB=64
MAX_PAGES=100
MAX_PIXELS=24000000
MAX_TRANSLATION_CHARS=30000
JOB_TIMEOUT=1800
# Exact HTTPS hostnames only. Every redirect and image host must be allowed.
AUTHORIZED_SOURCE_HOSTS=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
DEEPL_API_KEY=
DEEPL_URL=https://api-free.deepl.com/v2/translate
DEEPL_GLOSSARY_ID=
DEEPL_MONTHLY_CHARACTER_BUDGET=100000
GOOGLE_API_KEY=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
GOOGLE_VISION_API_KEY=
CLOUD_OCR_MONTHLY_REQUEST_BUDGET=100
# OCR.space free endpoint only. Each upload/tile counts as a request.
CLOUD_OCR_PROVIDER=ocr_space
OCR_SPACE_API_KEY=
OCR_SPACE_DAILY_REQUEST_BUDGET=50
OCR_SPACE_MONTHLY_REQUEST_BUDGET=400
OCR_SPACE_ENGINE3_MONTHLY_BUDGET=300
OCR_SPACE_PAGE_REQUEST_BUDGET=12
OCR_SPACE_ENGINE3_FALLBACK=true
